{
  "expo": {
    "name": "AI Safety Audit",
    "slug": "ai-safety-audit",
    "scheme": "aisafetyaudit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aisafetyaudit.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to record safety audit videos of the factory floor.",
        "NSPhotoLibraryUsageDescription": "Used to select safety audit videos to upload.",
        "NSMicrophoneUsageDescription": "Used to record audio alongside safety audit videos."
      }
    },
    "android": {
      "package": "com.aisafetyaudit.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6C4CF1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AI Safety Audit to access your videos to upload safety footage.",
          "cameraPermission": "Allow AI Safety Audit to use the camera to record safety footage."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6C4CF1"
        }
      ],
      "expo-video",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://10.38.253.20:8080/api/v1",
      "router": {},
      "eas": {
        "projectId": "bcc4838e-e727-4c54-ab6f-eac23fbb876a"
      }
    },
    "owner": "santhoshs007s-team"
  }
}
